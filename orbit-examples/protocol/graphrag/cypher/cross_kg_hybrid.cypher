CALL orbit.graphrag.buildKnowledge('business_kg','doc_b1','Apple Inc. acquired NeXT. Steve Jobs returned to Apple after the acquisition.',{source:'news',category:'business'},{extractors:['entity','relationship'],build_graph:true,generate_embeddings:true}) YIELD kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms RETURN kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms;
CALL orbit.graphrag.buildKnowledge('business_kg','doc_b2','Apple produces the iPhone and iPad.',{source:'catalog',category:'products'},{extractors:['entity','relationship'],build_graph:true,generate_embeddings:true}) YIELD kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms RETURN kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms;
CALL orbit.graphrag.buildKnowledge('research_kg','doc_r1','Transformers rely on attention mechanisms.',{source:'paper',category:'ml'},{extractors:['entity','relationship'],build_graph:true,generate_embeddings:true}) YIELD kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms RETURN kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms;
CALL orbit.graphrag.buildKnowledge('research_kg','doc_r2','Graph Neural Networks use message passing between nodes.',{source:'wiki',category:'ml'},{extractors:['entity','relationship'],build_graph:true,generate_embeddings:true}) YIELD kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms RETURN kg_name, document_id, entities_extracted, relationships_extracted, processing_time_ms;
CALL orbit.graphrag.ragQuery('business_kg','Summarize Apple product relationships.',{max_hops:2,include_path_reasoning:true}) YIELD response AS r1, confidence AS c1, reasoning_paths AS p1 RETURN r1, c1, p1 UNION CALL orbit.graphrag.ragQuery('research_kg','Explain attention vs message passing.',{max_hops:3,include_path_reasoning:true}) YIELD response AS r2, confidence AS c2, reasoning_paths AS p2 RETURN r2, c2, p2;
CALL orbit.graphrag.findPaths('business_kg','Apple Inc.','iPhone',{max_hops:3}) YIELD path_nodes, relationships, score RETURN path_nodes, relationships, score;
CALL orbit.graphrag.findPaths('research_kg','Transformers','Graph Neural Networks',{max_hops:4}) YIELD path_nodes, relationships, score RETURN path_nodes, relationships, score;
