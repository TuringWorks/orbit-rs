FOR result IN GRAPHRAG_BUILD_KNOWLEDGE("Apple Inc. acquired NeXT. Steve Jobs returned to Apple after the acquisition.", {"knowledge_graph": "business_kg", "document_id": "doc_b1", "metadata": {"source": "news", "category": "business"}, "extractors": ["entity", "relationship"], "build_graph": true, "generate_embeddings": true}) RETURN result
FOR result IN GRAPHRAG_BUILD_KNOWLEDGE("Apple produces the iPhone and iPad.", {"knowledge_graph": "business_kg", "document_id": "doc_b2", "metadata": {"source": "catalog", "category": "products"}, "extractors": ["entity", "relationship"], "build_graph": true, "generate_embeddings": true}) RETURN result
FOR result IN GRAPHRAG_BUILD_KNOWLEDGE("Transformers rely on attention mechanisms.", {"knowledge_graph": "research_kg", "document_id": "doc_r1", "metadata": {"source": "paper", "category": "ml"}, "extractors": ["entity", "relationship"], "build_graph": true, "generate_embeddings": true}) RETURN result
FOR result IN GRAPHRAG_BUILD_KNOWLEDGE("Graph Neural Networks use message passing between nodes.", {"knowledge_graph": "research_kg", "document_id": "doc_r2", "metadata": {"source": "wiki", "category": "ml"}, "extractors": ["entity", "relationship"], "build_graph": true, "generate_embeddings": true}) RETURN result
FOR answer IN GRAPHRAG_QUERY("business_kg", "Summarize Apple product relationships.", {"max_hops": 2, "include_explanation": true}) RETURN {"response": answer.response, "confidence": answer.confidence, "entities": answer.entities_involved}
FOR answer IN GRAPHRAG_QUERY("research_kg", "Explain attention vs message passing.", {"max_hops": 3, "include_explanation": true}) RETURN {"response": answer.response, "confidence": answer.confidence, "entities": answer.entities_involved}
FOR path IN GRAPHRAG_FIND_PATHS("business_kg", "Apple Inc.", "iPhone", {"max_hops": 3}) RETURN {"path_nodes": path.path_nodes, "relationships": path.relationships, "score": path.score}
FOR path IN GRAPHRAG_FIND_PATHS("research_kg", "Transformers", "Graph Neural Networks", {"max_hops": 4}) RETURN {"path_nodes": path.path_nodes, "relationships": path.relationships, "score": path.score}
