query TTTTT
SELECT jsonb_typeof('1'::jsonb), jsonb_typeof('"s"'::jsonb), jsonb_typeof('[]'::jsonb), jsonb_typeof('{}'::jsonb), jsonb_typeof('null'::jsonb)
