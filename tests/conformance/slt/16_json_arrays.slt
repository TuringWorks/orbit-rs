# JSON/JSONB and arrays.

query TTTTT
SELECT '{"a": 1, "b": {"c": [1,2,3]}}'::jsonb -> 'a', '{"a": 1, "b": {"c": [1,2,3]}}'::jsonb ->> 'a', '{"a": 1, "b": {"c": [1,2,3]}}'::jsonb -> 'b' -> 'c' -> 1, '{"a": 1, "b": {"c": [1,2,3]}}'::jsonb #> '{b,c,0}', '{"a": 1, "b": {"c": [1,2,3]}}'::jsonb #>> '{b,c,2}'
